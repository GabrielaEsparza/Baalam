# RESEND_API_KEY=                  (sin esto los correos salen en la consola)
# BUCKET_NAME= BUCKET_ENDPOINT= BUCKET_ACCESS_KEY_ID= BUCKET_SECRET_ACCESS_KEY=
# USDA_API_KEY=                    (gratis en https://fdc.nal.usda.gov/api-key-signup; sin ella usa DEMO_KEY)
# NUTRITION_RETENTION_DAYS=30       (días que se guardan los registros de comida)
